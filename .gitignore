# the built site is not kept: it is what a run makes, and the repository holds
# the program that makes it. See `make export`, which empties the folder
# first so a renamed post leaves no orphan behind.
dist/

# the compiled program: make build writes it
baumkuchen

# the finished programs: make release and make bundle write them
build/

# the usual noise
*.test
*.out
.DS_Store

# the coverage profile
.cover.out
posts_bkup/
